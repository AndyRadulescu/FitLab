rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check if the current user is an admin
    function isAdmin() {
      return isSignedIn() && 
        getUserData().isAdmin == true;
    }

    // Helper to check if the current user is a coach
    function isCoach() {
      return isSignedIn() && 
        (getUserData().isCoach == true || isAdmin());
    }

    // Specific rule for the users table
    // Users can read/write their own doc, coaches can read client docs, admins have full read/write/delete access
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isCoach() || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Specific rule for the connections table
    match /connections/{connectionId} {
      allow read: if isSignedIn() && (
        resource.data.coachId == request.auth.uid || 
        resource.data.clientId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && (
        (isCoach() && request.resource.data.coachId == request.auth.uid) || 
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        (isCoach() && resource.data.coachId == request.auth.uid) || 
        isAdmin()
      );
    }

    // Generic rule for collections where documents have a 'userId' field (checkins, weights)
    match /{collectionName}/{docId} {
      allow read: if isSignedIn() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        isCoach() || 
        isAdmin()
      );
      allow write: if isSignedIn() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // Specific rule for logs
    match /logs/{logId} {
      allow read, write: if isSignedIn();
    }
  }
}
